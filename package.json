{
  "name": "omni-agent",
  "version": "0.1.0",
  "description": "Local Mastra Agent Team with routing, Claude Code execution, cron management, and file-backed memory.",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "gateway": "node scripts/gateway-manager.mjs",
    "build": "mastra build",
    "start": "mastra start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:change-sync": "node scripts/verify-change-sync.mjs",
    "prpool:ingest": "tsx scripts/pr-pool-ingest.ts",
    "index:code": "npx gitnexus analyze",
    "verify": "npm run typecheck && npm test && npm run verify:change-sync"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.32.1",
    "@mastra/libsql": "1.10.0",
    "@mastra/memory": "1.17.5",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "mastra": "1.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
