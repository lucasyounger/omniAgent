# Copy this file to .env and fill in local values.
# Never commit .env.

# LLM provider used by Mastra model ids such as deepseek/deepseek-v4-flash.
# Get the key from the DeepSeek Open Platform API Keys page.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Project/runtime paths.
# OMNI_PROJECT_ROOT can normally be omitted; set it only when running from a
# directory where package.json cannot be discovered.
OMNI_PROJECT_ROOT=
# Semicolon-separated local roots where CodeAgent may operate.
OMNI_ALLOWED_WORKSPACES=L:\Code

# Claude Code / code execution.
# Must be available on PATH, or set an absolute executable path.
OMNI_CLAUDE_COMMAND=claude
# direct starts Claude Code after approval; patch_proposal writes a review
# artifact and does not modify the workspace.
OMNI_CODE_EXECUTION_MODE=patch_proposal
OMNI_CODE_TASK_BACKGROUND_TIMEOUT_MS=1800000
OMNI_CODE_TASK_BACKGROUND_MAX_RETRIES=0
OMNI_CODE_TASK_BACKGROUND_WAIT_TIMEOUT_MS=1000

# Mastra runtime/background settings.
OMNI_BACKGROUND_GLOBAL_CONCURRENCY=5
OMNI_BACKGROUND_PER_AGENT_CONCURRENCY=2
OMNI_BACKGROUND_DEFAULT_TIMEOUT_MS=1800000
OMNI_BACKGROUND_MAX_RETRIES=0
OMNI_MASTRA_SCHEDULER_TICK_INTERVAL_MS=10000

# Runtime polling settings.
OMNI_CRON_POLL_INTERVAL_MS=30000
OMNI_TEAM_TIMEOUT_POLL_INTERVAL_MS=30000
OMNI_TASK_DISPATCH_POLL_INTERVAL_MS=30000
OMNI_TASK_DISPATCH_MAX_CONCURRENT=2
OMNI_TASK_DISPATCH_LEASE_MS=120000

# Omni Gateway.
OMNI_API_BASE_URL=http://localhost:4111/api
OMNI_GATEWAY_PORT=4120
OMNI_GATEWAY_DELIVERY_POLL_MS=2000
OMNI_GATEWAY_DELIVERY_MAX_ATTEMPTS=3
OMNI_GATEWAY_DELIVERY_RETRY_DELAY_MS=30000
# Used by /pair <token>. Replace with a long random value.
OMNI_GATEWAY_PAIRING_TOKEN=change-this-local-pairing-token
# Semicolon-separated sender ids that can use the gateway without /pair.
OMNI_GATEWAY_ALLOW_SENDERS=

# OneBot/NapCat-compatible QQ bridge.
# Example: http://127.0.0.1:3000
OMNI_ONEBOT_HTTP_URL=

# Official QQ Bot adapter.
# Create a bot in QQ Open Platform, then copy AppID and AppSecret here.
OMNI_QQBOT_APPID=
OMNI_QQBOT_CLIENTSECRET=
