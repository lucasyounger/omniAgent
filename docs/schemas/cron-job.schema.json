{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CronJob",
  "type": "object",
  "required": ["id", "name", "schedule", "task", "status", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "schedule": {
      "type": "string",
      "description": "Execution schedule. User-entered one-time and daily schedules are interpreted as CST (UTC+8) at creation and stored in UTC as YYYY-MM-DD HH:mm or daily HH:mm; cron expressions are stored unchanged."
    },
    "task": { "type": "string" },
    "taskType": { "type": "string" },
    "targetAgent": { "type": "string" },
    "targetAgentId": { "type": "string" },
    "workspacePath": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "notifyTarget": {
      "type": "object",
      "required": ["channel", "accountId", "conversationId", "messageType"],
      "properties": {
        "channel": { "type": "string" },
        "accountId": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "messageType": { "type": "string", "enum": ["dm", "group", "guild", "system"] }
      }
    },
    "status": { "type": "string", "enum": ["active", "paused"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "lastRunAt": { "type": "string" },
    "lastRunTaskId": { "type": "string" },
    "lastRunTeamTaskId": { "type": "string" },
    "lastRunTeamRunId": { "type": "string" },
    "lastRunStatus": { "type": "string", "enum": ["started", "failed", "skipped"] },
    "lastRunError": { "type": "string" },
    "lastDispatchStatus": {
      "type": "string",
      "enum": ["dispatched", "waiting_user_confirm", "skipped", "failed"]
    },
    "lastDispatchError": { "type": "string" }
  }
}
