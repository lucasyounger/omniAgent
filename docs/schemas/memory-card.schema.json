{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCard",
  "status": "unimplemented",
  "description": "This schema describes a PLANNED but NOT YET IMPLEMENTED memory model. The current memory system uses flat Markdown/JSONL files (USER.md, EPISODIC_LOG.md, doc-update-proposals.jsonl) with MemoryProposalType='user|project|lesson|reference'. Do not treat this schema as reflecting current runtime behavior.",
  "type": "object",
  "required": ["id", "kind", "title", "content", "confidence", "stability", "tags", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["user_preference", "project_fact", "procedure", "decision", "episode"]
    },
    "title": { "type": "string" },
    "content": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stability": {
      "type": "string",
      "enum": ["temporary", "stable", "canonical"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
